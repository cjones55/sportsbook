# Copy to .env (or set these in your host's dashboard).
PORT=3000
BOOK_NAME=The Book
# First admin account, created on first start only. Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# The Odds API key (https://the-odds-api.com). Can also be pasted in Admin > Settings.
# Leave empty to run on demo odds.
ODDS_API_KEY=
# Where the SQLite database lives. Point this at a persistent disk in production.
DATA_DIR=./data
